# /etc/systemd/system/blockchain-data-mcp.service
# Env (mode, binds, vendor keys, limits) in /etc/blockchain-data-mcp/env (mode 0600).
# Writable state: /var/lib/blockchain-data-mcp/{config,data}. Put a TLS reverse proxy in front of the
# public bind; never proxy the admin bind (127.0.0.1:8788), reach it over an SSH tunnel.
[Unit]
Description=blockchain-data-mcp (blockchain data for agents: MCP + REST)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/blockchain-data-mcp/env
Environment=BDM__SERVER__DATA_DIR=/var/lib/blockchain-data-mcp/data
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/blockchain-data-mcp serve --config-dir /var/lib/blockchain-data-mcp/config
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# sandbox
DynamicUser=yes
StateDirectory=blockchain-data-mcp
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
