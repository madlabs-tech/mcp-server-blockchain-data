# onchain-data-mcp configuration via environment
# Precedence: built-in registry < config/config.toml < config/secrets.toml < env (this file)
# Env-set values show as "locked by env" in the dashboard.
# No inline comments on active lines: docker --env-file and systemd EnvironmentFile take them as part of the value.
# Signup links and free tiers: docs/VENDORS.md. Every key is optional:
# with none, public RPCs and keyless vendors are used. Deployment: DEPLOYMENT.md.

# ---------------------------------------------------------------- server
# self_hosted | hosted (hosted requires client keys)
ODM__SERVER__MODE=self_hosted
# self_hosted HTTP (REST + /mcp + dashboard)
ODM__SERVER__HTTP_BIND=127.0.0.1:8787
# ODM__SERVER__PUBLIC_BIND=0.0.0.0:8787  # hosted: public MCP/REST behind a TLS reverse proxy
# ODM__SERVER__ADMIN_BIND=127.0.0.1:8788 # hosted: dashboard + admin API (never public)
# payments | trading | neobank | defi | all | custom
ODM__SERVER__TOOL_PROFILE=all
# ODM__SERVER__CACHE_MAX_ENTRIES=20000   # small-VPS memory cap
# ODM__SERVER__DATA_DIR=./data           # sqlite bdm.db (usage counters, client keys, call log)
# ODM__SERVER__QUOTA_POLL_SECS=300       # how often vendor usage APIs are polled
# ODM__SERVER__WARMUP=true               # background eth_chainId check of every active EVM RPC at startup
# ODM__SERVER__DASHBOARD=true            # dashboard + admin API (password: run `onchain-data-mcp password`)
# Password for the web dashboard. At least 12 characters. If empty, one is made for you — run `onchain-data-mcp password` to see it.
# DASHBOARD_PASSWORD=
RUST_LOG=info

# ---------------------------------------------------------------- vendor keys (verified free tiers)
ALCHEMY_API_KEY=
HELIUS_API_KEY=
# QuickNode multichain endpoint: https://{name}.{network}.quiknode.pro/{token}/
QN_ENDPOINT_NAME=
QN_TOKEN_ID=
# Demo plan key (x-cg-demo-api-key)
COINGECKO_API_KEY=
ONEINCH_API_KEY=
BIRDEYE_API_KEY=
MORALIS_API_KEY=
# Hermes/Benchmarks (price_history for native coins)
PYTH_API_KEY=
OPENEXCHANGERATES_APP_ID=
# keyless works; a key raises the vendor's limit
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# keyless: 1 req/s, 100/day
TRM_API_KEY=
# keyless: 30/min; with key: 60/min (set ODM__VENDORS__JUPITER__LIMIT__PER_MINUTE=60)
JUPITER_API_KEY=

# ---------------------------------------------------------------- free tier unconfirmed (disabled by default)
# ANKR_API_KEY=
# ZEROEX_API_KEY=
# UNISWAP_API_KEY=
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# RUGCHECK_API_KEY=

# ---------------------------------------------------------------- legacy (deprecated)
# RPC_URL=                               # now applies to Ethereum ONLY (previously every chain used it)

# ---------------------------------------------------------------- per-vendor limits / caps (examples)
# limit = the vendor's real quota (defaults to its free tier); cap = your own budget below the limit
# ODM__VENDORS__ALCHEMY__LIMIT__MONTHLY_CREDITS=30000000
# ODM__VENDORS__ALCHEMY__CAP__MONTHLY_CREDITS=15000000
# ODM__VENDORS__ALCHEMY__RESERVE_PCT=10
# ODM__VENDORS__ALCHEMY__ON_EXHAUSTED=skip        # skip | allow_overage
# ODM__VENDORS__HELIUS__CAP__RPS=5
# ODM__VENDORS__COINGECKO__CAP__MONTHLY_CREDITS=8000
# ODM__VENDORS__MORALIS__ENABLED=false

# ---------------------------------------------------------------- routing order (primary,fallback,...)
# ODM__ROUTING__DEFAULTS__EVM_RPC=alchemy,quicknode,public
# ODM__ROUTING__DEFAULTS__SOLANA_RPC=helius,quicknode,public
# ODM__ROUTING__DEFAULTS__PRICE=coingecko,defillama,geckoterminal,dexscreener

# ---------------------------------------------------------------- hosted mode: per-client defaults
# Create the first client key before starting hosted mode: onchain-data-mcp clients create <name>
# ODM__CLIENTS__DEFAULT__REQUESTS_PER_MINUTE=30
# ODM__CLIENTS__DEFAULT__DAILY_REQUESTS=1000
# ODM__CLIENTS__DEFAULT__MONTHLY_CREDITS=200000
# ODM__CLIENTS__DEFAULT__TOOL_PROFILE=payments
