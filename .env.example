# evm-mcp-server configuration via environment
# Precedence: built-in registry < config/config.toml < config/secrets.toml < env (this file)
# Env-set values show as "locked by env" in the dashboard.
# Signup links and free tiers: plan/VENDORS.md. Every key is optional; see "zero-key mode" in plan/DEPLOYMENT.md.

# ---------------------------------------------------------------- server
EMS__SERVER__MODE=self_hosted            # self_hosted | hosted (hosted requires client keys)
EMS__SERVER__HTTP_BIND=127.0.0.1:8787    # self_hosted HTTP (REST + /mcp + dashboard)
# EMS__SERVER__PUBLIC_BIND=0.0.0.0:8787  # hosted: public MCP/REST behind a TLS reverse proxy
# EMS__SERVER__ADMIN_BIND=127.0.0.1:8788 # hosted: dashboard + admin API (never public)
EMS__SERVER__TOOL_PROFILE=payments       # payments | trading | neobank | defi | all | custom
# EMS__SERVER__CACHE_MAX_ENTRIES=20000   # small-VPS memory cap
# EMS__SERVER__DATA_DIR=./data           # sqlite ems.db (usage counters, client keys, call log)
# EMS__SERVER__QUOTA_POLL_SECS=300       # how often vendor usage APIs are polled
# EMS__SERVER__DASHBOARD=true            # dashboard + admin API (token in config/admin_token)
RUST_LOG=info

# ---------------------------------------------------------------- Tier A vendor keys (test Release 1)
ALCHEMY_API_KEY=
HELIUS_API_KEY=
QN_ENDPOINT_NAME=                        # QuickNode multichain endpoint: https://{name}.{network}.quiknode.pro/{token}/
QN_TOKEN_ID=
COINGECKO_API_KEY=                       # Demo plan key (x-cg-demo-api-key)
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
ONEINCH_API_KEY=
TRM_API_KEY=                             # free sanctions screening API
# optional Tier A
JUPITER_API_KEY=
BIRDEYE_API_KEY=
MORALIS_API_KEY=
OPENEXCHANGERATES_APP_ID=

# ---------------------------------------------------------------- Tier B vendor keys (Release 2)
ZERION_API_KEY=
THEGRAPH_API_KEY=
CDP_API_KEY_ID=                          # Coinbase CDP: x402 facilitator + Onramp quotes
CDP_API_KEY_SECRET=
PIMLICO_API_KEY=
PYTH_API_KEY=                            # Pyth Benchmarks (historical prices)
SAFE_API_KEY=

# ---------------------------------------------------------------- free tier unconfirmed (disabled by default)
# ANKR_API_KEY=
# ZEROEX_API_KEY=
# UNISWAP_API_KEY=
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# RUGCHECK_API_KEY=
# LIFI_API_KEY=

# ---------------------------------------------------------------- legacy (deprecated)
# RPC_URL=                               # now applies to Ethereum ONLY (previously every chain used it)

# ---------------------------------------------------------------- per-vendor limits / caps (examples)
# limit = the vendor's real quota (defaults to its free tier); cap = your own budget below the limit
# EMS__VENDORS__ALCHEMY__LIMIT__MONTHLY_CREDITS=30000000
# EMS__VENDORS__ALCHEMY__CAP__MONTHLY_CREDITS=15000000
# EMS__VENDORS__ALCHEMY__RESERVE_PCT=10
# EMS__VENDORS__ALCHEMY__ON_EXHAUSTED=skip        # skip | allow_overage
# EMS__VENDORS__HELIUS__CAP__RPS=5
# EMS__VENDORS__COINGECKO__CAP__MONTHLY_CREDITS=8000
# EMS__VENDORS__MORALIS__ENABLED=false

# ---------------------------------------------------------------- routing order (primary,fallback,...)
# EMS__ROUTING__DEFAULTS__EVM_RPC=alchemy,quicknode,public
# EMS__ROUTING__DEFAULTS__SOLANA_RPC=helius,quicknode,public
# EMS__ROUTING__DEFAULTS__PRICE=coingecko,defillama,geckoterminal,dexscreener

# ---------------------------------------------------------------- hosted mode: per-client defaults
# Create the first client key before starting hosted mode: evm-mcp-server clients create <name>
# EMS__CLIENTS__DEFAULT__REQUESTS_PER_MINUTE=30
# EMS__CLIENTS__DEFAULT__DAILY_REQUESTS=1000
# EMS__CLIENTS__DEFAULT__MONTHLY_CREDITS=200000
# EMS__CLIENTS__DEFAULT__TOOL_PROFILE=payments
